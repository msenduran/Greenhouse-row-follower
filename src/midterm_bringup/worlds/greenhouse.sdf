    <model name="wall_west">
      <static>true</static>
      <pose>-2.5 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 5.4 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 5.4 0.8</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>8.5 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 5.4 0.8</size></box></geometry></collision>
