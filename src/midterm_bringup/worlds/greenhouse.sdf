    <model name="wall_north">
      <static>true</static>
      <pose>3.0 2.7 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>11.1 0.1 0.8</size></box></geometry></collision>
        <visual name="visual">
