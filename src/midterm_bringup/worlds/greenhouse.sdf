<?xml version="1.0"?>
<!-- Generated greenhouse world: 3 planter rows (y = [1.4, 0.0, -1.4]), 2 aisles, fruit on the middle row.
     Layout: see docs/scenario.md -->
<sdf version="1.9">
  <world name="greenhouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.55 0.55 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="row_0">
      <static>true</static>
      <pose>3.0 1.4 0 0 0 0</pose>
      <link name="planter">
        <pose>0 0 0.15 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.0 0.4 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.4 0.3</size></box></geometry>
          <material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material>
        </visual>
      </link>
      <link name="foliage">
        <pose>0 0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5.8 0.35 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5.8 0.35 0.6</size></box></geometry>
          <material><ambient>0.15 0.45 0.15 1</ambient><diffuse>0.15 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="row_1">
      <static>true</static>
      <pose>3.0 0.0 0 0 0 0</pose>
      <link name="planter">
        <pose>0 0 0.15 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.0 0.4 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.4 0.3</size></box></geometry>
          <material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material>
        </visual>
      </link>
      <link name="foliage">
        <pose>0 0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5.8 0.35 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5.8 0.35 0.6</size></box></geometry>
          <material><ambient>0.15 0.45 0.15 1</ambient><diffuse>0.15 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="row_2">
      <static>true</static>
      <pose>3.0 -1.4 0 0 0 0</pose>
      <link name="planter">
        <pose>0 0 0.15 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.0 0.4 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.4 0.3</size></box></geometry>
          <material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material>
