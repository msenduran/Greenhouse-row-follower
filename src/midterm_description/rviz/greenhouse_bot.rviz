Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 20
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.3
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
      Keep: 50
      Shape:
        Value: Arrow
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Decay Time: 0
      Value: true
    - Class: rviz_imu_plugin/Imu
      Name: IMU
      Enabled: true
      Topic:
        Value: /imu
        Reliability Policy: Best Effort
      fixed_frame_orientation: true
      Box properties:
        Enable box: true
        x_scale: 0.3
        y_scale: 0.15
        z_scale: 0.05
        alpha: 0.4
        color: 30; 80; 200
      Axes properties:
        Enable axes: true
        Axes scale: 0.4
        Axes alpha: 1
      Acceleration properties:
        Enable acceleration: false
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Fruit detection
      Enabled: true
      Topic:
        Value: /fruit_detector/debug_image
        Reliability Policy: Reliable
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Behavior
      Enabled: true
      Topic:
        Value: /behavior/markers
      Value: true
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 3.6
      Target Frame: base_footprint
Window Geometry:
  Width: 1200
  Height: 800
