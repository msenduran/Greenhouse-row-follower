<?xml version="1.0"?>
<!--
  2D LiDAR on a short mast, at plant height (~0.35 m above ground) so the scan hits the rows.
  Data: /scan (sensor_msgs/msg/LaserScan), frame lidar_link.
  Index mapping (360 samples, angle_min = -pi): back = 0, right = 90, front = 180, left = 270.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="lidar_x" value="0.10"/>
  <xacro:property name="lidar_z" value="0.275"/>   <!-- from base_link (+0.075 → 0.35 m above ground) -->
  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.05"/>
  <xacro:property name="lidar_mast_radius" value="0.015"/>
  <!-- Mast runs from the chassis top plate to the bottom of the sensor -->
  <xacro:property name="lidar_mast_bottom" value="${chassis_z + chassis_height/2}"/>
  <xacro:property name="lidar_mast_length" value="${lidar_z - lidar_height/2 - lidar_mast_bottom}"/>

  <link name="lidar_mast">
    <visual>
      <geometry><cylinder radius="${lidar_mast_radius}" length="${lidar_mast_length}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <xacro:cylinder_inertia m="0.05" r="${lidar_mast_radius}" h="${lidar_mast_length}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>
  </link>

  <joint name="lidar_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mast"/>
    <origin xyz="${lidar_x} 0 ${lidar_mast_bottom + lidar_mast_length/2}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Red ring marks the sensor head -->
    <visual>
      <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${lidar_radius * 0.8}" length="0.01"/></geometry>
      <material name="lidar_red"><color rgba="0.8 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.2" r="${lidar_radius}" h="${lidar_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi - 2*pi/360}</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- 0.20 m minimum ignores hits on the robot's own masts -->
          <min>0.20</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
