<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid box: x/y/z are full edge lengths -->
  <xacro:macro name="box_inertia" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
               iyy="${m * (x*x + z*z) / 12.0}" iyz="0"
               izz="${m * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder with its axis along local z -->
  <xacro:macro name="cylinder_inertia" params="m r h *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (3*r*r + h*h) / 12.0}" ixy="0" ixz="0"
               iyy="${m * (3*r*r + h*h) / 12.0}" iyz="0"
               izz="${m * r * r / 2.0}"/>
    </inertial>
  </xacro:macro>

</robot>
