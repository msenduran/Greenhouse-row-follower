<?xml version="1.0"?>
<!--
  Front depth camera, low on the front face and tilted 15 deg down, so it sees low obstacles
  below the LiDAR plane (e.g. crates left in the aisle) as well as taller ones.
  Data: /depth_camera/depth_image (sensor_msgs/msg/Image, 32FC1, metres),
        /depth_camera/points (sensor_msgs/msg/PointCloud2), /depth_camera/camera_info.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="depth_camera_x" value="${chassis_length/2 + 0.015}"/>
  <xacro:property name="depth_camera_z" value="0.10"/>   <!-- from base_link (+0.075 → ~0.18 m above ground) -->
  <xacro:property name="depth_camera_pitch" value="${15 * pi / 180}"/>

  <link name="depth_camera_link">
    <visual>
      <geometry><box size="0.03 0.10 0.03"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Two lenses (IR projector + receiver) -->
    <visual>
      <origin xyz="0.016 0.025 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="0.008" length="0.004"/></geometry>
      <material name="lens_blue"/>
    </visual>
    <visual>
      <origin xyz="0.016 -0.025 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="0.008" length="0.004"/></geometry>
      <material name="lens_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.10 0.03"/></geometry>
    </collision>
    <xacro:box_inertia m="0.1" x="0.03" y="0.10" z="0.03">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>

  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="${depth_camera_x} 0 ${depth_camera_z}" rpy="0 ${depth_camera_pitch} 0"/>
  </joint>

  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <topic>depth_camera</topic>
      <gz_frame_id>depth_camera_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <camera_info_topic>depth_camera/camera_info</camera_info_topic>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>4.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>
